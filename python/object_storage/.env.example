# Local dev (uv): copy to `python/object_storage/.env` and adjust.
# Docker Compose (repo root): DB host is `postgres-object-storage`; S3 is `http://rustfs:9000` inside the stack.

APP_NAME="ML Experiment Object Storage"
API_PREFIX="/api"
# For local browser uploads to this service directly, list origins explicitly (Compose template uses localhost:3000).
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

DATABASE_URL="postgresql+asyncpg://myuser:myuser@localhost:5432/object_storage"

# RustFS uses the existing S3 client. Match these keys to the RustFS credentials.
S3_ENDPOINT_URL="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="admin"
S3_SECRET_ACCESS_KEY="password"
S3_BUCKET="ml-blobs"
