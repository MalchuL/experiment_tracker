# Local dev (uv): copy to `python/backend/.env` and adjust.
# Docker Compose (repo root): DB host is `postgres-backend` (see docker-compose.yml defaults).

DATABASE_URL="postgresql+asyncpg://myuser:myuser@localhost:5432/experiment_tracker"
JWT_SECRET=your-secure-secret-key
APP_NAME=Experiment Tracker
API_PREFIX="/api"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

SCALARS_SERVICE_URL=http://127.0.0.1:8001/api
OBJECT_STORAGE_SERVICE_URL=http://127.0.0.1:8002/api
