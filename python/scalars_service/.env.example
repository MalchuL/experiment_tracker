# Local dev (uv): copy to `python/scalars_service/.env` and adjust.
# Docker Compose (repo root): set `CLICKHOUSE_URL` / `REDIS_URL` in a root `.env` if you override defaults in docker-compose.yml.
CLICKHOUSE_URL=http://default:yourpass@localhost:8123/default

# Redis cache (scalars service). If Redis runs from the repo root Compose stack on the host, the default published port is 6380 (not 6379):
# REDIS_URL=redis://localhost:6380/0
REDIS_URL=redis://localhost:6379/0
