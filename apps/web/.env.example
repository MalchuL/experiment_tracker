# Browser → main API base URL. Read by the Next.js server at runtime and injected
# into the page for browser requests. Use a URL the user's browser can reach.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# API path prefix shown in SDK config hints on the API tokens page (default /api).
# NEXT_PUBLIC_API_PREFIX=/api

# Set this to the URL of the API server. This is used to make requests to the API server internally.
SERVER_API_BASE_URL=http://127.0.0.1:8000
