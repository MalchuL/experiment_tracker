# Browser → main API base URL. Inlined at `pnpm run build` (Next.js NEXT_PUBLIC_*).
# Docker: set the same value as compose build-arg `NEXT_PUBLIC_BASE_URL` (root `.env.example`).
# Use a URL the user's browser can reach (e.g. http://127.0.0.1:8000 when API is published on the host).
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8000
