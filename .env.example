# Optional: copy to `.env` at the repository root to override Docker Compose defaults.
# Quick public URL (no .env): from repo root run `./scripts/docker-up-public.sh https://your-ui-origin`
# (see README → "Custom URL or domain" → "One command without a `.env` file").
# Application defaults for local `uv` / `pnpm` dev live in each package `*/.env.example`.

# --- Ports (host) ---
# Main Postgres (backend DB): compose default host port is 5435 (see docker-compose.yml) so it does not fight a local PostgreSQL on 5432. Override if busy; backend still connects to postgres-backend:5432 inside Compose:
# POSTGRES_BACKEND_PORT=5436
# Second Postgres (object storage): compose default host port is 5434 (see docker-compose.yml). Override if that port is busy; object-storage still connects to postgres-object-storage:5432 inside Compose:
# POSTGRES_OBJECT_STORAGE_PORT=5436
# MLTools Postgres: compose default host port is 5436.
# POSTGRES_MLTOOLS_PORT=5437
# Redis: compose default host port is 6380 (see docker-compose.yml). Override if busy; scalars still uses redis://redis:6379/0 inside Compose:
# REDIS_PORT=6381
# CLICKHOUSE_HTTP_PORT=8123
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OBJECT_STORAGE_PORT=8002
# SCALARS_PORT=8001
# BACKEND_PORT=8000
# WEB_PORT=3000
# MLTOOLS_PORT=8003

# --- Web container (server-side BFF → backend). Browser still uses NEXT_PUBLIC_BASE_URL (build arg). ---
# When `web` runs in this Compose file, keep the default so Route Handlers reach `backend` over the Docker network:
# SERVER_API_BASE_URL=http://backend:8000

# --- Web image (inlined at `next build`; not changed at container start) ---
# URL the **browser** uses to reach the main API (scheme + host + port). Local example:
# NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8000
#
# Custom host / HTTPS example (rebuild `web` after changing — see root README "Custom URL or domain"):
# NEXT_PUBLIC_BASE_URL=https://api.example.com

# --- Backend / security (override compose defaults in production) ---
# JWT_SECRET=change-me-in-docker-env
# ADMIN_PANEL_KEY=admin
# MLTOOLS_BACKEND_API_TOKEN=pat_token_with_experiments.view_and_metrics.view

# --- CORS (comma-separated origins: scheme + host + port; must match the UI as the browser sends `Origin`) ---
# Local:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OBJECT_STORAGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Custom UI URL (add both if you use several entrypoints):
# ALLOWED_ORIGINS=https://tracker.example.com,https://www.tracker.example.com
# OBJECT_STORAGE_ALLOWED_ORIGINS=https://tracker.example.com,https://www.tracker.example.com

# --- Infra credentials (defaults match docker-compose.yml) ---
# POSTGRES_USER=tracker
# POSTGRES_PASSWORD=tracker
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=yourpass
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=password
